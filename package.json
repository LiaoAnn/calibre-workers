{
  "name": "calibre-workers",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 8787 --host",
    "build": "vite build",
    "build:prod": "CLOUDFLARE_ENV=prod pnpm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:converter": "cd src/containers/converter && go test ./...",
    "test:converter:integration": "cd src/containers/converter && go test -v -count=1 -tags=integration ./...",
    "typecheck": "tsc",
    "knip": "knip",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm run db:apply --remote && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:apply": "wrangler d1 migrations apply calibre-workers-db",
    "db:studio": "drizzle-kit studio"
  },
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "a random, high-entropy secret string for Better Auth"
      }
    }
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@effect/experimental": "^0.58.0",
    "@effect/platform": "^0.94.5",
    "@effect/sql": "^0.49.0",
    "@effect/sql-d1": "^0.47.0",
    "@effect/sql-drizzle": "^0.48.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.19.19",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "knip": "^6.29.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ]
  }
}